      "source": [
        "# Python program to check if number is palindrome"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "num = int(input(\"Enter a number: \"))\n",
        "original = num\n",
        "reverse = 0\n",
        "while num > 0:\n",
        "    digit = num % 10\n",
        "    reverse = reverse * 10 + digit\n",
        "    num //= 10\n",
        "if original == reverse:\n",
        "    print(f\"{original} is a palindrome.\")\n",
        "else:\n",
        "    print(f\"{original} is not a palindrome.\")"
      ],
