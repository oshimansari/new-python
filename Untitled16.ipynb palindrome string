    {
      "cell_type": "code",
      "source": [
        "string = input(\"Enter a string: \")\n",
        "# Reverse the string\n",
        "reverse = string[::-1]\n",
        "# Check palindrome\n",
        "if string == reverse:\n",
        "    print(\"String is palindrome\")\n",
        "else:\n",
        "    print(\"String is not palindrome\")"
      ],
