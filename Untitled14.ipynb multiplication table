      "source": [
        "# python program to print the multiplication table of a number"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "num = int(input(\"Enter a number: \"))\n",
        "print(\"Multiplication table of\", num)\n",
        "for i in range(1, 11):\n",
        "    print(num, \"x\", i, \"=\", num * i)\n",
        "\n"
      ],
